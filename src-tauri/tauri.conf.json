{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pi.Décodeur",
  "version": "0.1.0",
  "identifier": "com.oligens.pi.decodeur",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "title": "Pi.Décodeur",
      "width": 1280,
      "height": 800,
      "minWidth": 980,
      "minHeight": 640,
      "resizable": true
    }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "identifier": "com.oligens.pi.decodeur"
  }
}
